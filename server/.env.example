MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=agai_cms
HOST=127.0.0.1
PORT=5001
ADMIN_ORIGIN=http://localhost:5177
PUBLIC_API_URL=http://localhost:5001
WEBSITE_URL=https://agaiphysiotherapy.com
# Required in production; generate at least 32 random characters.
SESSION_SECRET=
# Production: NODE_ENV=production, HOST=127.0.0.1 behind an HTTPS reverse proxy.
# Set TRUST_PROXY=1 only when exactly one trusted reverse proxy fronts Node.

# Vercel: use an Atlas MONGODB_URI and your canonical HTTPS origin for
# PUBLIC_API_URL and ADMIN_ORIGIN. Configure secrets in Vercel environment variables
# (see README). Do not deploy this local environment file.
# ADMIN_EMAIL=admin@agaiphysiotherapy.com
# ADMIN_PASSWORD=  # Initialization only; at least 12 characters
# INITIALIZE_DATABASE=true  # Vercel Production only; remove after first successful setup
