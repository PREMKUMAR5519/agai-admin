{
  "name": "agai-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "dev:api": "npm run dev:server",
    "dev:web": "npm run dev:client",
    "build": "npm run build --workspace client && node scripts/copy-assets.js",
    "build:vercel": "node scripts/vercel-build.js",
    "start": "npm run start --workspace server",
    "setup": "npm run setup --workspace server",
    "test": "npm run test --workspace server",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.2.0",
    "vite": "^8.3.5"
  }
}
